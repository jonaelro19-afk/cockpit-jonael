# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma (base de données locale + client généré)
/prisma/dev.db
/prisma/dev.db-journal
/src/generated

# skills injectées par "prisma init" (non utilisées)
/.claude
/.agents
/.windsurf
/skills-lock.json

# artefact ponctuel de migration SQLite → Postgres (contient des jetons)
/scripts/data-dump.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
