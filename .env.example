# Copie ce fichier en ".env" et remplis les valeurs.
# (Le vrai .env n'est jamais versionné.)

# --- Base de données : Postgres (Neon) ---
# neon.tech → ton projet → Connection string
DATABASE_URL=            # connexion "pooled" (hôte avec -pooler)
DATABASE_URL_UNPOOLED=   # connexion "direct" (sans -pooler) — pour les migrations

# --- Auth.js / NextAuth ---
# Génère une valeur avec : npx auth secret   (ou : openssl rand -base64 33)
AUTH_SECRET=
# URL publique de l'app (en local : http://localhost:3000 ; en prod : l'URL Vercel)
AUTH_URL=http://localhost:3000

# --- Identifiants OAuth Google ---
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Seule cette adresse Google pourra se connecter à l'app.
ALLOWED_EMAIL=ton.email@gmail.com

# --- IA (propositions de réponse aux mails) ---
# Une seule clé suffit. Sans clé, le reste de l'app fonctionne normalement.
#
# GRATUIT : Google Gemini — aistudio.google.com → "Get API key" (sans carte).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# PAYANT (ne s'entraîne pas sur les données) : console.anthropic.com → API keys.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
